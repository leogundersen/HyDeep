        "################################ Cell 4: Hybrid semiparametric model- RK 4 solver #######################################\n",
        "\n",
        "@torch.compile(fullgraph=False)\n",
        "def solve_ode_semi_parametric(ode_func, state, t, tf, h, model, target_max, output_max, controls, pca_loadings_denorm, pca_loadings_norm, pca_loadings_pinv):\n",
        "\n",
        "    #define time space as beginning to end of time step \n",
        "    n_steps = ((tf - t) / h).to(torch.int64)\n",
        "    times = t + h * torch.arange(n_steps, device=t.device)\n",
        "\n",
        "    #times = torch.arange(t, tf, h) #time is tensor and not Python floats\n",
        "\n",
        "    for t in times:\n",
        "        #h_current = tf - t\n",
        "\n",
        "        #add for overshooting control (when tf-t < h), minimum between time step and (final time and current time)\n",
        "        h_current = torch.minimum(torch.tensor(h, dtype=t.dtype), tf - t) #ensures tensor, compatible with compile\n",
        "\n",
        "        #Runge-Kutta steps\n",
        "        k1 = ode_func(t, state, model, target_max, output_max, controls, pca_loadings_denorm, pca_loadings_norm, pca_loadings_pinv, n_pc)\n",
        "\n",
        "        k2 = ode_func(t + h_current / 2, state + h_current / 2 * k1, model, target_max, output_max, controls, pca_loadings_denorm, pca_loadings_norm, pca_loadings_pinv, n_pc)\n",
        "\n",
        "        k3 = ode_func(t + h_current / 2, state + h_current / 2 * k2, model, target_max, output_max, controls, pca_loadings_denorm, pca_loadings_norm, pca_loadings_pinv, n_pc)\n",
        "\n",
        "        k4 = ode_func(t + h_current, state + h_current * k3, model, target_max, output_max, controls, pca_loadings_denorm, pca_loadings_norm, pca_loadings_pinv, n_pc)\n",
        "\n",
        "        #update state and time\n",
        "        state = state + h_current * (k1 / 6 + k2 / 3 + k3 / 3 + k4 / 6) #POSSIBLE ISSUE: iterative loop, updates in loop\n",
        "        \n",
        "        #state[state<0] = 0\n",
        "\n",
        "        if torch.isnan(state).any() or torch.isinf(state).any():\n",
        "            print(\"STATE EXPLODED\")\n",
        "        \n",
        "    return state"
      ]
    },
