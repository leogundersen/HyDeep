        "################################### Cell 3: ODE Function for Hybrid-semiparametric ########################################\n",
        "\n",
        "#@torch.compile(fullgraph=False)\n",
        "def solve_ode(t, state, model, target_max, output_max, controls, pca_loadings_denorm, pca_loadings_norm, pca_loadings_pinv, n_pc):\n",
        "\n",
        "        #controls are split and set in proper shape\n",
        "        Feed = controls[:, 0].unsqueeze(1) #L/h\n",
        "        feed_state = controls[:, 1].unsqueeze(1) #0 or 1\n",
        "        \n",
        "        #state, volume and biomass are split and set in proper shape\n",
        "        state_without_V = state[:, :-1] # remove the last element (V) from the state vector\n",
        "        V = state[:, -1].unsqueeze(1) # the last element is V (L)\n",
        "        X = state[:, 0].unsqueeze(1) # the first element is X (g/L)\n",
        "\n",
        "        if torch.isnan(state_without_V).any():\n",
        "                print(\"state already contains NaN\")\n",
        "\n",
        "        pca_loadings_pinv_denorm = pca_loadings_pinv \n",
        "        Z_max = target_max @ pca_loadings_pinv_denorm.T\n",
        "        #print(\"Z_max:\", Z_max)\n",
        "        state_scaled = state_without_V \n",
        "\n",
        "        #print(\"pca_loadings_denorm_pinv:\",pca_loadings_denorm_pinv)\n",
        "        #print(\"state_scaled:\", state_scaled)\n",
        "        state_pca = state_scaled #@ pca_loadings_denorm_pinv.T \n",
        "\n",
        "        input_wPCA = state_pca \n",
        "        \n",
        "        if debug: \n",
        "                print(\"pca_loadings_norm shape:\", pca_loadings_norm.shape)\n",
        "                print(\"state_scaled shape:\", state_scaled.shape)\n",
        "                print(\"state_without_V max:\", torch.abs(state_without_V).max())\n",
        "                print(\"pca_loadings_pinv max:\", pca_loadings_pinv.max())\n",
        "                print(\"pca_loadings_norm max:\", pca_loadings_norm.max())\n",
        "                print(\"pca_loadings_denorm max:\", pca_loadings_denorm.max())\n",
        "                print(\"state_scaled max:\", state_scaled.max())\n",
        "                print(\"input_wPCA max:\", input_wPCA.max())\n",
        "\n",
        "        model_input = torch.cat([input_wPCA, feed_state], 1)\n",
        "        #print(\"model_input:\", model_input)\n",
        "        model_output = model(model_input) #* 0.10\n",
        "        #print(\"model_output:\", model_output)\n",
        "        #rates = model_output @ pca_loadings_denorm.T\n",
        "        rates = model_output #* output_max \n",
