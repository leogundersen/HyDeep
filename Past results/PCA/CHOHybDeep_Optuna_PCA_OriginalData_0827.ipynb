        "    controls=controls_sequence\n",
        ")\n",
        "\n",
        "pred_trainval = torch.from_numpy(pred_trainval) * target_max\n",
        "\n",
        "pred_full_trainval = true_data.clone()\n",
        "for j, b in enumerate(trainval_batches):\n",
